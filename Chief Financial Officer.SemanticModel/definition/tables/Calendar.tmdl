	hierarchy 'Jerarquía Date'
		lineageTag: df353ac7-e039-4f79-acd6-eb46724e5cfe

		level #Year
			lineageTag: 9db8ef70-6efc-4fa4-a5ba-b90e3aa9c1fa
			column: #Year

		level #Quarter
			lineageTag: 589b71ec-ed23-4cf3-9cb6-65dc8709ab51
			column: #Quarter

		level #Month
			lineageTag: 5d852eea-2ce2-4e76-9ee5-4dc524a83ce9
			column: #Month

	partition Calendar = calculated
		mode: import
		source =
				
					VAR holidays = {
						"01/01/2023",
						"01/01/2024",
						"01/01/2025",
						"01/01/2026",
						"28/07/2023",
						"29/07/2023",
						"28/07/2024",
						"29/07/2024",
						"28/07/2025",
						"29/07/2025",
						"24/12/2023",
						"25/12/2023",
						"24/12/2024",
						"25/12/2024",
						"24/12/2025",
						"25/12/2025",
						"01/11/2023",
						"01/11/2024",
						"01/11/2025",
						"01/05/2023",
						"01/05/2024",
						"01/05/2025",
						"06/04/2023",
						"07/04/2023",
						"28/03/2024",
						"29/03/2024",
						"17/04/2025",
						"18/04/2025",
						"29/06/2023",
						"29/06/2024",
						"29/06/2025",
						"08/10/2023",
						"08/10/2024",
						"08/10/2025",
						"08/12/2023",
						"08/12/2024",
						"08/12/2025"
					}
					VAR result = ADDCOLUMNS(
						CALENDAR(
							FIRSTDATE(Fact_Revenue[Id_Date]),
							LASTDATE(Fact_Revenue[Id_Date])
						),
						"#Year", YEAR([Date]),
						"#Quarter", QUARTER([Date]),
						"Quarter", "Q" & QUARTER([Date]),
						"#Month", MONTH([Date]),
						"Month", FORMAT(
							[Date],
							"MMM",
							"En-US"
						),
						"#Weeknum", WEEKNUM(
							[Date],
							2
						),
				        "#Weekday",WEEKDAY([Date],2),
						"Day", FORMAT(
							[Date],
							"DDD",
							"En_US"
						),
						"#Day", DAY([Date]),
						"Holiday", IF(
							FORMAT(
								[Date],
								"DD/MM/YYYY"
							) IN holidays,
							1,
							0
						),
				        "Weekend",IF(FORMAT([Date],"DDD","En-US") IN {"Sun","Sat"},1,0)
					)
					RETURN
						result

	annotation PBI_Id = ef5c54ba5b594905bb69fff64419ead6

