		displayFolder: Financial
		lineageTag: bc1dc8db-3f17-4115-89d0-e37aa961e99b

	measure '#Gross Profit' = fx_RevenueCategory({"Revenue"}) - fx_ExpenseCategory({"Cost of Goods Sold"})
		formatString: "S/"\ #,0.00;-"S/"\ #,0.00;"S/"\ #,0.00
		displayFolder: Income Statement
		lineageTag: 532b14d1-a62f-41b4-9f51-98be8abf67e7

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure #Opex = fx_ExpenseLineItem({"Operating Expenses"})
