table _Measures
	lineageTag: 24403e82-457e-46bc-a685-ef941d9de838

	measure #Revenue = SUMX(Fact_Revenue,Fact_Revenue[Quantity]*RELATED(DimProducts[Price_Unit]))
		formatString: "S/"\ #,0.00;-"S/"\ #,0.00;"S/"\ #,0.00
		displayFolder: Basics
		lineageTag: e997868d-3c67-41c3-8adb-4879a3c79a16

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure #Expenses = SUMX(Fact_Expenses,Fact_Expenses[Subtotal])
		formatString: "S/"\ #,0.00;-"S/"\ #,0.00;"S/"\ #,0.00
		displayFolder: Basics
		lineageTag: 8acd5847-6db8-47ef-9e0c-70dc0b6fa0aa

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure '#Net Income' = [#EBT]-[#Income Tax Expense]
		formatString: "S/"\ #,0.00;-"S/"\ #,0.00;"S/"\ #,0.00
		displayFolder: Income Statement
		lineageTag: 5f8e4393-8b5f-4099-ac78-b874c837b195

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure '#Net Margin on Op.Rev(%)' = fx_OverOperatingRevenue([#Net Income])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Income Statement
		lineageTag: d5d85b96-cecb-468f-9ac7-420fce31531d

	measure '#BEP Sales' = DIVIDE([#Fixed Cost],1-fx_OverOperatingRevenue([#Variable Cost]),0)
		formatString: "S/"\ #,0.00;-"S/"\ #,0.00;"S/"\ #,0.00
		displayFolder: Financial
		lineageTag: 0d1cafdf-b93f-4f6a-a3eb-311888ab5f03

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure '#COGS Ratio(%)' = fx_OverOperatingRevenue(fx_ExpenseCategory({"Cost of Goods Sold"}))
