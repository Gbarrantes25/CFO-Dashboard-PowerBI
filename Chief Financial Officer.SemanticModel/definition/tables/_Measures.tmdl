		displayFolder: Financial
		lineageTag: 134007b1-7799-4450-adcc-9fd2d6e3cef1

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure #EBIT = [#Gross Profit]-[#Opex]
