		displayFolder: Income Statement
		lineageTag: 3bcfccd6-2eef-4fa8-80f3-468252c7272d

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure '#Income Tax Expense' = [#EBT]*0.295
